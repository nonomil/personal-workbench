[
  {
    "id": "poem-chunxiao",
    "title": "春晓",
    "author": "孟浩然",
    "theme": "spring",
    "lines": [
      "春眠不觉晓",
      "处处闻啼鸟",
      "夜来风雨声",
      "花落知多少"
    ],
    "source": {
      "kind": "project-original",
